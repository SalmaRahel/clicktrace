{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Span",
  "description": "One recorded step of a click, with a start time and a duration.",
  "type": "object",
  "properties": {
    "traceId": { "type": "string", "pattern": "^(?!0+$)[0-9a-f]{32}$" },
    "spanId": { "type": "string", "pattern": "^(?!0+$)[0-9a-f]{16}$" },
    "parentSpanId": {
      "type": ["string", "null"],
      "pattern": "^(?!0+$)[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "CLICK",
        "HTTP_CLIENT",
        "HTTP_SERVER",
        "DB_QUERY",
        "QUEUE_PUBLISH",
        "QUEUE_CONSUME",
        "ERROR"
      ]
    },
    "name": { "type": "string" },
    "service": { "type": "string" },
    "startUnixMs": { "type": "integer" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["OK", "ERROR"] },
    "attributes": { "type": "object" }
  },
  "required": [
    "traceId",
    "spanId",
    "parentSpanId",
    "kind",
    "name",
    "service",
    "startUnixMs",
    "durationMs",
    "status"
  ],
  "additionalProperties": false
}
